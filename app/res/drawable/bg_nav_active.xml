<?xml version="1.0" encoding="utf-8"?>
<!--
  하단 탭 한 칸의 배경.

  selected일 때만 알약이 칠해지고, 나머지 상태에서는 투명하다. 선택 표시를
  코드에서 setBackgroundResource로 갈아 끼우지 않는 이유는 그렇게 하면 선택되지
  않은 탭에서 리플(누름 피드백)이 사라지기 때문이다. 여기에 다 넣어 두면
  Tabs는 setSelected만 부르면 된다.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40F0C030">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape>
                    <solid android:color="@color/nav_active_bg" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@android:color/transparent" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
