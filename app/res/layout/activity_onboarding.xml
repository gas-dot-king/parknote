<?xml version="1.0" encoding="utf-8"?>
<!--
  첫 실행 안내의 껍데기.

  단계가 바뀌면 onboardingBody의 자식만 갈아 끼운다. 예전에는 화면 전체를 자바로
  다시 만들어 setContentView를 또 불렀는데, PhoneWindow는 콘텐츠 전환 기능이 꺼져
  있을 때만 이전 뷰를 지우므로 그 기능이 켜진 테마에서 화면이 겹쳤다.

  RelativeLayout인 이유: LinearLayout + layout_weight로 "본문은 남는 공간 전부,
  버튼 줄은 아래 고정"을 만들었더니 실제 기기에서 가중치가 버튼 줄로 가서 본문
  ScrollView가 높이 0으로 찌그러졌다(본문은 들어 있는데 화면에는 안 보였다).
  여기서는 버튼 줄을 부모 아래에 붙이고 본문을 그 위 공간에 못 박으므로,
  남는 공간을 누가 가져가는지를 두고 다툴 여지가 없다.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/onboardingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingLeft="24dp"
    android:paddingTop="28dp"
    android:paddingRight="24dp"
    android:paddingBottom="20dp">

    <TextView
        android:id="@+id/onboardingStep"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.08"
        android:textColor="@color/subtext"
        android:textSize="11sp" />

    <!-- 아래 고정. 본문이 아무리 길어도 이 줄은 늘 화면 안에 있다. -->
    <LinearLayout
        android:id="@+id/onboardingNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/onboardingBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif"
            android:gravity="center_vertical"
            android:minHeight="@dimen/touch_min"
            android:paddingLeft="12dp"
            android:paddingRight="20dp"
            android:textColor="@color/subtext"
            android:textSize="14sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/onboardingNext"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_min"
            android:background="@drawable/bg_button_active"
            android:fontFamily="sans-serif-medium"
            android:paddingLeft="28dp"
            android:paddingRight="28dp"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textColor="@color/on_accent"
            android:textSize="15sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/onboardingNav"
        android:layout_below="@id/onboardingStep"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="12dp"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/onboardingBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</RelativeLayout>
