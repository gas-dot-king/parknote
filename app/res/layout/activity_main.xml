<?xml version="1.0" encoding="utf-8"?>
<!--
  탭 네 개를 담는 껍데기.

  ViewPager2도 Fragment도 쓰지 않는다. 이 앱은 프레임워크만으로 만들어져 있고,
  탭 넷은 서로 상태를 거의 공유하지 않아 visibility 토글이면 충분하다. 대신 네
  화면이 항상 인플레이트돼 있으므로, 각 탭은 자기 화면이 보일 때만 무거운 일
  (예: 위치 탭의 나침반 센서)을 시작해야 한다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include layout="@layout/tab_home" />

        <include layout="@layout/tab_history" />

        <include layout="@layout/tab_location" />

        <include layout="@layout/tab_settings" />
    </FrameLayout>

    <include layout="@layout/bottom_nav" />
</LinearLayout>
