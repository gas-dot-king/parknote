<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      부모는 DeviceDefault가 아니라 Material이다. DeviceDefault는 제조사가 시스템 다크모드에
      연동해 라이트로 바꿔 버리는 기기(삼성 One UI 등)가 있어서, 우리가 칠한 밝은 글자가
      흰 배경에 묻힌다. 앱이 모든 면과 글자색을 직접 칠하므로 OEM 위젯 스타일이 필요 없다.
    -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">@color/accent</item>
        <!-- 다이얼로그 테마를 고정한다. 날짜·시각 피커는 alertDialogTheme를 보지 않고
             자기 속성을 따로 읽으므로 셋 다 같은 테마로 묶는다. -->
        <item name="android:alertDialogTheme">@style/AppDialog</item>
        <item name="android:datePickerDialogTheme">@style/AppDialog</item>
        <item name="android:timePickerDialogTheme">@style/AppDialog</item>
    </style>

    <!-- 앱 안의 모든 AlertDialog·피커가 쓰는 테마. 색을 전부 명시해 OEM 기본값에 기대지 않는다. -->
    <style name="AppDialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:colorBackground">@color/card</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/subtext</item>
        <!-- setItems / setSingleChoiceItems 목록 항목 색 -->
        <item name="android:textColorAlertDialogListItem">@color/text</item>
    </style>

    <!-- 위젯 구역 버튼 공통 스타일 -->
    <style name="ZoneButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">@dimen/gutter</item>
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- 위젯 버튼 행 공통 스타일 -->
    <style name="ZoneRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <!--
      하단 탭 한 칸. 칸 전체가 터치 타깃이라 아이콘만 겨냥할 필요가 없다.
      선택 표시는 배경(알약)과 아이콘 색 두 가지로 하며, 색만으로 구분하지 않는다.
    -->
    <style name="NavTab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginLeft">2dp</item>
        <item name="android:layout_marginRight">2dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:drawablePadding">3dp</item>
        <item name="android:background">@drawable/bg_nav_active</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- 탭 화면 공통: 하단 바에 가리지 않게 아래 여백을 넉넉히 둔다. -->
    <style name="TabScroll">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:fillViewport">true</item>
        <item name="android:scrollbars">none</item>
        <item name="android:clipToPadding">false</item>
    </style>

    <style name="TabColumn">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingLeft">@dimen/page_padding</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingRight">@dimen/page_padding</item>
        <item name="android:paddingBottom">20dp</item>
    </style>

    <!-- 섹션 머리글. 거터를 써서 아래 목록의 왼쪽 끝과 한 줄로 떨어진다. -->
    <style name="SectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginLeft">@dimen/gutter</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">@color/subtext</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!--
      상태 카드의 보조 조작 (수정 · 삭제 · 구역 편집 · 추가).

      예전에는 TextView + padding 4dp라 실측 48dp가 아니라 26dp였다. 운전 직후
      한 손으로 누르는 앱에서 제일 아픈 지점이었고, TextView라 리플 피드백도 없고
      스크린 리더에 버튼으로 읽히지도 않았다.
    -->
    <style name="InlineAction">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/touch_min</item>
        <item name="android:minWidth">56dp</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
