<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      반경·거터·패딩은 여기서만 정한다.

      리디자인 때 이 값들을 XML 8곳과 Java 5곳에 숫자로 흩뿌려 두는 바람에,
      거터를 4dp → 3dp로 내리는 변경이 절반(ZoneGrid·목록 행)에만 적용되고
      나머지 절반(섹션 머리글, 직접 입력 버튼)은 4dp로 남아 왼쪽 모서리가
      1dp씩 어긋났다. 같은 실수를 반복하지 않으려고 토큰으로 뺀다.
    -->

    <!-- 카드·다이얼로그처럼 큰 면 -->
    <dimen name="radius_card">14dp</dimen>
    <!-- 버튼·입력처럼 손에 닿는 것 -->
    <dimen name="radius_control">12dp</dimen>
    <dimen name="stroke">1dp</dimen>

    <!--
      카드·버튼·목록 행이 공유하는 바깥 여백. 섹션 머리글도 같은 값을 쓰기 때문에
      머리글의 왼쪽 끝과 그 아래 목록의 왼쪽 끝이 한 줄로 떨어진다.
    -->
    <dimen name="gutter">4dp</dimen>

    <dimen name="page_padding">18dp</dimen>
    <dimen name="card_padding">22dp</dimen>

    <!--
      운전 직후 한 손으로 누르는 앱이다. 탭할 수 있는 것은 무엇이든 이 아래로
      내려가지 않는다. 배경은 styles.xml의 InlineAction 주석에 있다.
    -->
    <dimen name="touch_min">48dp</dimen>

    <!--
      위젯 본체 반경. Android 12부터 런처가 위젯을
      @android:dimen/system_app_widget_background_radius로 잘라내므로 v31에서는
      그 값을 그대로 따른다(values-v31/dimens.xml). 여기 16dp는 시스템 값이 없는
      API 26~30용 근사치다. 이 값이 시스템 클립보다 작으면 모서리마다 배경화면이
      초승달 모양으로 비친다.
    -->
    <dimen name="widget_radius">16dp</dimen>
</resources>
